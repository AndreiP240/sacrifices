[sub_resource type="GDScript" id="GDScript_sgb2t"]
resource_name = "touch"
script/source = "extends Area2D
var PlatformScene = preload(\"res://red_platform.tscn\")
var SpringScene = preload(\"res://red_spring.tscn\")
func _ready():
	connect(\"body_entered\", Callable(self, \"_on_body_entered\"))
func _on_body_entered(body):
	if body.is_in_group(\"player\"):
		print(\"Player touched me!\")
		if not body.is_on_floor():
			var platform = PlatformScene.instantiate()
			var offset = Vector2(0, 32)
			platform.position = global_position + offset
			get_tree().current_scene.add_child(platform)
		else:
			var springLocation = body.global_position
			var spring = SpringScene.instantiate()
			var offset = Vector2(0, -32)
			body.global_position = Vector2(0,0)
			spring.position = springLocation + offset
			get_tree().current_scene.add_child(spring)
		body.velocity = Vector2.ZERO
		body.global_position = Vector2(0,0)
"

